# Copy this file to .env and paste your own values from Supabase.
# Never share the secret "service_role" key. Only use the anon (public) key here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
# Optional override. In Vercel, set this to the deployed production URL.
# When omitted, password recovery uses the current browser origin.
# VITE_APP_URL=https://your-weather-app.vercel.app
